rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['username', 'avatarId', 'createdAt'])
                    && request.resource.data.username is string
                    && request.resource.data.avatarId is string;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /users/{userId}/favourites/{gameSlug} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/playQueue/{gameSlug} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /settings/gameOfTheMonth {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.username is string
                    && request.resource.data.avatarId is string
                    && request.resource.data.authorPhotoURL is string
                    && request.resource.data.gameSlug is string
                    && request.resource.data.gameTitle is string
                    && request.resource.data.coverImage is string
                    && request.resource.data.reviewText is string
                    && request.resource.data.score is number
                    && request.resource.data.aesthetics is string
                    && request.resource.data.valueForMoney is string
                    && request.resource.data.likeCount == 0
                    && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
                    && (
                      (
                        resource.data.userId == request.auth.uid
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.reviewText is string
                        && request.resource.data.score is number
                        && request.resource.data.aesthetics is string
                        && request.resource.data.valueForMoney is string
                        && request.resource.data.avatarId is string
                        && request.resource.data.authorPhotoURL is string
                        && request.resource.data.likeCount == resource.data.get('likeCount', 0)
                      )
                      || (
                        request.resource.data.userId == resource.data.userId
                        && request.resource.data.username == resource.data.username
                        && request.resource.data.avatarId == resource.data.avatarId
                        && request.resource.data.authorPhotoURL == resource.data.authorPhotoURL
                        && request.resource.data.gameSlug == resource.data.gameSlug
                        && request.resource.data.gameTitle == resource.data.gameTitle
                        && request.resource.data.coverImage == resource.data.coverImage
                        && request.resource.data.reviewText == resource.data.reviewText
                        && request.resource.data.score == resource.data.score
                        && request.resource.data.aesthetics == resource.data.aesthetics
                        && request.resource.data.valueForMoney == resource.data.valueForMoney
                        && request.resource.data.createdAt == resource.data.createdAt
                        && (
                          request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
                          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
                        )
                      )
                    );
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      match /agrees/{agreeUserId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.uid == agreeUserId
                      && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == agreeUserId;
        allow update: if false;
      }
    }

    match /forumThreads/{threadId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.body is string
                    && request.resource.data.authorUsername is string
                    && request.resource.data.avatarId is string
                    && request.resource.data.authorPhotoURL is string
                    && request.resource.data.replyCount == 0
                    && request.resource.data.likeCount == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
                    && (
                      resource.data.authorId == request.auth.uid
                      || (
                        request.resource.data.title == resource.data.title
                        && request.resource.data.body == resource.data.body
                        && request.resource.data.authorId == resource.data.authorId
                        && request.resource.data.authorUsername == resource.data.authorUsername
                        && request.resource.data.avatarId == resource.data.avatarId
                        && request.resource.data.authorPhotoURL == resource.data.authorPhotoURL
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.likeCount == resource.data.likeCount
                        && request.resource.data.replyCount == resource.data.replyCount + 1
                      )
                      || (
                        request.resource.data.title == resource.data.title
                        && request.resource.data.body == resource.data.body
                        && request.resource.data.authorId == resource.data.authorId
                        && request.resource.data.authorUsername == resource.data.authorUsername
                        && request.resource.data.avatarId == resource.data.avatarId
                        && request.resource.data.authorPhotoURL == resource.data.authorPhotoURL
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.replyCount == resource.data.replyCount
                        && (
                          request.resource.data.likeCount == resource.data.likeCount + 1
                          || request.resource.data.likeCount == resource.data.likeCount - 1
                        )
                      )
                    );
      allow delete: if false;

      match /likes/{likeUserId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.uid == likeUserId
                      && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == likeUserId;
        allow update: if false;
      }

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.body is string
                      && request.resource.data.authorUsername is string
                      && request.resource.data.avatarId is string
                      && request.resource.data.authorPhotoURL is string
                      && request.resource.data.likeCount == 0
                      && request.resource.data.createdAt == request.time;
        allow update: if request.auth != null
                      && request.resource.data.body == resource.data.body
                      && request.resource.data.authorId == resource.data.authorId
                      && request.resource.data.authorUsername == resource.data.authorUsername
                      && request.resource.data.avatarId == resource.data.avatarId
                      && request.resource.data.authorPhotoURL == resource.data.authorPhotoURL
                      && request.resource.data.createdAt == resource.data.createdAt
                      && (
                        request.resource.data.likeCount == resource.data.likeCount + 1
                        || request.resource.data.likeCount == resource.data.likeCount - 1
                      );
        allow delete: if false;

        match /likes/{likeUserId} {
          allow read: if true;
          allow create: if request.auth != null
                        && request.auth.uid == likeUserId
                        && request.resource.data.createdAt == request.time;
          allow delete: if request.auth != null && request.auth.uid == likeUserId;
          allow update: if false;
        }
      }
    }

    match /{path=**}/replies/{replyId} {
      allow read: if true;
    }
  }
}
